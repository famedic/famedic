APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Docker Compose (nginx): usa http://localhost:8080 para que URLs y @vite coincidan con el puerto publicado.

# URL base (sin barra final) para logos/imágenes en correos. Si no se define, config/famedic.php usa https://famedic.com.mx
# FAMEDIC_EMAIL_PUBLIC_URL=https://famedic.com.mx

# PDF de órdenes de laboratorio: DomPDF (barryvdh/laravel-dompdf), solo PHP — sin Chromium en el servidor.

# Menú admin "Créditos a favor": false = navegable; true o sin definir = visible pero deshabilitado (default en config).
# ADMIN_COUPONS_NAVIGATION_DISABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose MySQL: desde Laravel DB_HOST=mysql. Desde Workbench: 127.0.0.1:3306.
# Usuario de aplicación (no uses root como MYSQL_USER en Docker).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=famedic
DB_USERNAME=famedic
DB_PASSWORD=famedic

# Opcional: credenciales del contenedor (por defecto coinciden con DB_* arriba).
# MYSQL_DATABASE=famedic
# MYSQL_USER=famedic
# MYSQL_PASSWORD=famedic
# MYSQL_ROOT_PASSWORD=root

# SQLite local (sin contenedor mysql): descomenta sqlite y comenta mysql arriba
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Colas: usar database|redis|sqs en staging/producción (nunca sync). Requiere worker: php artisan queue:work
# Ver docs/modulo-saldo-a-favor-creditos-cupones.md → "Cierre operativo — producción y staging"
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Solicitud de factura (laboratorio): si true, no se envían correos al equipo (recomendado en local).
SKIP_LABORATORY_INVOICE_REQUEST_MAIL=false
# En local/staging/testing: correo del usuario en BD que recibirá la notificación (vacío = no buscar).
# LAB_INVOICE_REQUEST_TEST_EMAIL=emedina.externo@odessa.com.mx
# Si no existe el usuario de prueba y esto es true, se notifica igual que en producción a quienes tengan el permiso.
# LAB_INVOICE_REQUEST_FALLBACK_TO_ADMINS=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Vonage SMS (laravel/vonage-notification-channel → config('vonage.*'))
# Consumidas hoy por LaboratoryResultsOtpNotification y SendPhoneVerificationCode.
# No colocar secretos reales en git. Validar KEY/SECRET/FROM y saldo en staging.
# =============================================================================
# VONAGE_KEY=
# VONAGE_SECRET=
# VONAGE_SMS_FROM=

# =============================================================================
# Laravel Sanctum — vigencia efectiva actual de tokens API (minutos)
# Default de producción/actual: 1440 (24 h). NO cambiar en P0-A1.
# El objetivo P0-A de 180 min vive en OTP_P0A_SANCTUM_TARGET_* + flag (abajo).
# =============================================================================
# SANCTUM_TOKEN_EXPIRATION=1440
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# SANCTUM_TOKEN_PREFIX=

# =============================================================================
# Akubica API v1 — OTP y tokens (comportamiento actual; defaults efectivos)
# =============================================================================
# AKUBICA_OTP_TTL_MINUTES=10
# AKUBICA_OTP_LENGTH=6
# AKUBICA_OTP_MAX_ATTEMPTS=5
# AKUBICA_TOKEN_TTL_MINUTES=1440
# AKUBICA_TOKEN_TTL_MINUTES_P0A_TARGET=180
# AKUBICA_PAYMENT_LINK_DEFAULT_EXPIRES_MINUTES=60

# =============================================================================
# Laboratory results OTP (web) — no forma parte de la activación Akubica P0-A1
# =============================================================================
# LAB_RESULTS_OTP_REQUIRED=false
# LAB_RESULTS_OTP_TRUST_MINUTES=15
# LAB_RESULTS_RESEND_SECONDS=60
# LAB_RESULTS_RATE_LIMIT=12
# LAB_RESULTS_SHARE_LINK_HOURS=12

# =============================================================================
# P0-A — Feature flags (TODOS desactivados por defecto; no activar en prod aún)
# Registro P0-A: REGISTER + INFRASTRUCTURE (+ ANTI_ABUSE exigido por assert).
# Infra OFF ignora REGISTER → flujo legacy email.
# SMS: además SMS_DELIVERY_ENABLED + OTP_P0A_DELIVERY_DRIVER=vonage + VONAGE_*.
# Fallback email: solo EMAIL_FALLBACK + fallo SMS temporal o sin teléfono (registro).
# Login P0-A SMS: LOGIN + ANTI_ABUSE + SMS_DELIVERY (sin fallback email silencioso).
# Sanctum 3h / step-up: no cablear en esta fase.
# Ver docs/Akubica/p0-a-registro-sms-fallback.md y p0-a-login-sms.md
# =============================================================================
# OTP_P0A_INFRASTRUCTURE_ENABLED=false
# OTP_P0A_SMS_DELIVERY_ENABLED=false
# OTP_P0A_EMAIL_FALLBACK_ENABLED=false
# OTP_P0A_DELIVERY_DRIVER=null
# OTP_P0A_DELIVERY_CONNECT_TIMEOUT=3
# OTP_P0A_DELIVERY_REQUEST_TIMEOUT=8
# OTP_P0A_DELIVERY_MAX_RETRIES=1
# OTP_P0A_DELIVERY_BACKOFF_MS=500
# OTP_P0A_DELIVERY_REDIS_CONNECTION=default
# OTP_P0A_DELIVERY_REDIS_PREFIX=otp:p0a
# OTP_P0A_DELIVERY_RESERVATION_TTL=600
# OTP_P0A_ANTI_ABUSE_ENABLED=false
# OTP_P0A_AKUBICA_LOGIN_ENABLED=false
# OTP_P0A_AKUBICA_REGISTER_ENABLED=false
# OTP_P0A_SANCTUM_3H_ENABLED=false
# Prefer TTL name (P0-C1); TARGET kept for backward compatibility when TTL unset.
# OTP_P0A_SANCTUM_TOKEN_TTL_MINUTES=180
# OTP_P0A_SANCTUM_TARGET_EXPIRATION_MINUTES=180
# OTP_P0A_STEP_UP_RESULTS_ENABLED=false
# OTP_P0A_STEP_UP_INVOICES_ENABLED=false
# OTP_P0A_STEP_UP_BEARER_DOWNLOADS_ENABLED=false
# OTP_P0A_STEP_UP_BEARER_RESULTS_ENABLED=false
# OTP_P0A_STEP_UP_BEARER_INVOICES_ENABLED=false
# OTP_P0A_SECURE_LINKS_RESULTS_ENABLED=false
# OTP_P0A_SECURE_LINKS_INVOICES_ENABLED=false

# =============================================================================
# P0-A — Política objetivo (inactiva hasta flags; valores DEC aprobados)
# primary_channel: sms|email
# fallback_mode: never|on_sms_failure|user_authorized
# max_resends = reenvíos ADICIONALES (la solicitud inicial no cuenta)
# =============================================================================
# OTP_P0A_TTL_MINUTES=5
# TTL independiente del registro Akubica (P0-A5; default 10, no hereda el 5 de login)
# OTP_P0A_REGISTER_TTL_MINUTES=10
# OTP_P0A_LENGTH=6
# OTP_P0A_MAX_ATTEMPTS=5
# OTP_P0A_COOLDOWN_SECONDS=60
# OTP_P0A_RESEND_WINDOW_MINUTES=30
# OTP_P0A_MAX_RESENDS=3
# OTP_P0A_BLOCK_MINUTES=30
# OTP_P0A_REQUIRE_VERIFIED_PHONE=true
# OTP_P0A_PRIMARY_CHANNEL=sms
# OTP_P0A_FALLBACK_MODE=on_sms_failure
# OTP_P0A_AUDIT_ENABLED=true

# =============================================================================
# P0-A3 — Antiabuso (infraestructura; flag OTP_P0A_ANTI_ABUSE_ENABLED=false)
# identity_max_requests: techo por identidad+purpose (efectivo = min(este, 1+max_resends))
# ip_max_requests: techo por IP hasheada+purpose
# rate_limit_window_minutes: ventana de contadores
# retention_days: horizonte de purga de otp_abuse_events (comando no programado aún)
# =============================================================================
# OTP_P0A_IDENTITY_MAX_REQUESTS=4
# OTP_P0A_IP_MAX_REQUESTS=20
# OTP_P0A_RATE_LIMIT_WINDOW_MINUTES=30
# OTP_P0A_ABUSE_RETENTION_DAYS=30

# =============================================================================
# P0-A — Step-up grant (P0-B1; otp_step_up_grants)
# =============================================================================
# OTP_P0A_STEP_UP_GRANT_TTL_MINUTES=10
# OTP_P0A_STEP_UP_BIND_SANCTUM_TOKEN=true
# OTP_P0A_STEP_UP_BIND_PURPOSE=true
# OTP_P0A_STEP_UP_BIND_RESOURCE=true

# =============================================================================
# P0-A — Sanctum objetivo 3 h (NO altera SANCTUM_TOKEN_EXPIRATION hasta flag)
# =============================================================================
# OTP_P0A_SANCTUM_TARGET_EXPIRATION_MINUTES=180

# =============================================================================
# P0-B2 — Secure download links (otp_secure_download_links)
# Code defaults remain TTL=60 / max_opens=5 for compatibility.
# Staging target for results: TTL=5, max_opens=1 (set explicitly below).
# =============================================================================
# OTP_P0A_SECURE_LINK_TTL_MINUTES=60
# OTP_P0A_SECURE_LINK_MAX_OPENS=5
# Staging P0-B2 recommended overrides:
# OTP_P0A_SECURE_LINK_TTL_MINUTES=5
# OTP_P0A_SECURE_LINK_MAX_OPENS=1

# =============================================================================
# P0-C2 — OTP pruning / maintenance (akubica:prune-otp)
# Default OFF. Dry-run unless --force. Does not prune personal_access_tokens
# (use sanctum:prune-expired --hours=24 separately). See docs/Akubica/p0-c2-*.
# =============================================================================
# OTP_P0A_CLEANUP_ENABLED=false
# OTP_P0A_CLEANUP_CHALLENGES_RETENTION_DAYS=30
# OTP_P0A_CLEANUP_DELIVERIES_RETENTION_DAYS=30
# OTP_P0A_CLEANUP_RATE_LIMITS_RETENTION_DAYS=7
# OTP_P0A_CLEANUP_GRANTS_RETENTION_DAYS=30
# OTP_P0A_CLEANUP_SECURE_LINKS_RETENTION_DAYS=30
# OTP_P0A_CLEANUP_DEFAULT_BATCH=1000
# OTP_P0A_CLEANUP_SCHEDULE_TIME=03:00

# =============================================================================
# API V1 — HTTP Idempotency (Idempotency-Key) phase 1
# Default OFF. Optional header on selected write routes. DB-backed (no Redis).
# Does not guarantee exactly-once when side effects complete but response was
# never persisted (failed_uncertain). Prune is separate from akubica:prune-otp.
# =============================================================================
# API_V1_IDEMPOTENCY_ENABLED=false
# API_V1_IDEMPOTENCY_TTL_HOURS=24
# API_V1_IDEMPOTENCY_PROCESSING_LEASE_SECONDS=60
# API_V1_IDEMPOTENCY_MAX_RESPONSE_BYTES=65536
# API_V1_IDEMPOTENCY_PRUNE_ENABLED=false
# API_V1_IDEMPOTENCY_PRUNE_BATCH=1000
# API_V1_IDEMPOTENCY_PRUNE_SCHEDULE_TIME=04:00

# =============================================================================
# API V1 — Audit trail (append-only) phase 1 infrastructure
# Default OFF. No business event instrumentation in this phase. Metadata is
# allowlist-only (max bytes/depth). Never store OTP, Bearer, bodies, or secrets.
# Cleanup / prune flags are intentionally absent (later block).
# =============================================================================
# API_V1_AUDIT_ENABLED=false
# API_V1_AUDIT_MAX_METADATA_BYTES=2048
# API_V1_AUDIT_MAX_METADATA_DEPTH=2

# =============================================================================
# Business audit trail (append-only) Block 6A — infrastructure only
# Independent from API_V1_AUDIT_*. Default OFF. No commerce/payment
# instrumentation in this phase. Never store PII, clinical, fiscal, or
# financial secrets. Cleanup / prune flags intentionally absent (later block).
# =============================================================================
# BUSINESS_AUDIT_ENABLED=false
# BUSINESS_AUDIT_MAX_METADATA_BYTES=2048
# BUSINESS_AUDIT_MAX_METADATA_DEPTH=2
# BUSINESS_AUDIT_MAX_METADATA_KEYS=32
# BUSINESS_AUDIT_CORRELATION_ID_MAX_LENGTH=128

# --- Merged from main ---

# MAIL_SAFE_MODE: en ambientes no productivos restringe destinatarios a la lista blanca.
# En production siempre se envía sin restricciones. Si no se define, el modo seguro queda activo fuera de production.
MAIL_SAFE_MODE=true
MAIL_ALLOWED_RECIPIENTS=qa@famedic.com.mx,dev@famedic.com.mx
MAIL_ALLOWED_DOMAINS=famedic.com.mx
MAIL_BLOCK_DISALLOWED=true
MAIL_LOG_BLOCKED=true

# Solicitud de factura (laboratorio): si true, no se envían correos al equipo (recomendado en local).
# Días naturales sin factura completa (PDF+XML) para marcar solicitud como atrasada (admin Facturación).
INVOICE_DELAY_THRESHOLD_DAYS=3

# Membresías médicas: false = solo venta regular (sin mes de prueba gratuito).
MEDICAL_ATTENTION_TRIAL_ENABLED=false

# PayPal (sandbox: developer.paypal.com → Apps → Sandbox credentials)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=

# OpenAI — Asistente IA de monitoreo (admin)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TAX_PROFILE_MODEL=
OPENAI_TIMEOUT=60
OPENAI_MAX_CONTEXT_CHARS=12000

# ActiveCampaign — integración global y módulo cupones/saldo (Fase A)
# Credenciales reales solo en .env local/staging/prod; no commitear tokens.
# ACTIVE_CAMPAIGN_API_ENDPOINT=
# ACTIVE_CAMPAIGN_API_TOKEN=
# ACTIVE_CAMPAIGN_ACCOUNT_ID=
# ACTIVE_CAMPAIGN_EVENT_KEY=
# ACTIVE_CAMPAIGN_LIST_NEW_USERS=
ACTIVE_CAMPAIGN_ENABLED=true
ACTIVE_CAMPAIGN_COUPONS_ENABLED=true
ACTIVE_CAMPAIGN_COUPONS_EXPIRING_ENABLED=false
ACTIVE_CAMPAIGN_COUPONS_EXPIRING_DAYS=14

# Tags cupones/créditos (nombre AC §17 o ID numérico en producción)
ACTIVE_CAMPAIGN_TAG_CREDIT_AVAILABLE=FM-Credito-Disponible
ACTIVE_CAMPAIGN_TAG_CREDIT_EXPIRING=FM-Credito-Por-Vencer
ACTIVE_CAMPAIGN_TAG_CREDIT_USED=FM-Credito-Usado
ACTIVE_CAMPAIGN_TAG_CREDIT_RESTORED=FM-Credito-Restaurado
ACTIVE_CAMPAIGN_TAG_CREDIT_REVOKED=FM-Credito-Revocado
ACTIVE_CAMPAIGN_TAG_CREDIT_CLOSED=FM-Credito-Cerrado
ACTIVE_CAMPAIGN_TAG_BENEFICIARY_PENDING=FM-Beneficiario-Pendiente-Registro
ACTIVE_CAMPAIGN_TAG_BENEFIT_ACTIVATED=FM-Beneficio-Activado
ACTIVE_CAMPAIGN_TAG_PROMO_VALIDATED=FM-Promo-Validada
ACTIVE_CAMPAIGN_TAG_PROMO_USED=FM-Promo-Usada
ACTIVE_CAMPAIGN_TAG_PROMO_ABANDONED=FM-Promo-Abandonada
ACTIVE_CAMPAIGN_TAG_AUTHORIZATION_PENDING=FM-Autorizacion-Pendiente

# Akubica UAT synthetic fixtures
AKUBICA_UAT_PRIMARY_EMAIL=
AKUBICA_UAT_PRIMARY_PHONE=
AKUBICA_UAT_PRIMARY_PHONE_COUNTRY=
AKUBICA_UAT_FOREIGN_EMAIL=
AKUBICA_UAT_FOREIGN_PHONE=
AKUBICA_UAT_FOREIGN_PHONE_COUNTRY=
AKUBICA_UAT_DISPOSABLE_EMAIL=
AKUBICA_UAT_DISPOSABLE_PHONE=
AKUBICA_UAT_DISPOSABLE_PHONE_COUNTRY=
