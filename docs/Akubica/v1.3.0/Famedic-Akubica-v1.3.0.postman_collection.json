{
  "info": {
    "name": "Famedic Akubica API v1.3.0",
    "version": "1.3.0",
    "description": "Regresión segura de catalogo, membresías, carrito medical_services, beneficios, checkout/prepare, reconocimiento pre-OTP y sandbox ATIX. No incluye pagos, payment links, activaciones, farmacia ni laboratorio transaccional.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const uuid = () => pm.variables.replaceIn('{{$guid}}');",
          "pm.environment.set('correlation_id', uuid());",
          "if (!pm.environment.get('idempotency_key')) pm.environment.set('idempotency_key', 'ak130-' + uuid());",
          "if (pm.request.url.toString().includes('/integrations/atix/phone-lookups')) {",
          "  const timestamp = Math.floor(Date.now() / 1000).toString();",
          "  const nonce = 'n-' + uuid();",
          "  const body = pm.request.body && pm.request.body.raw ? pm.variables.replaceIn(pm.request.body.raw) : '';",
          "  const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
          "  const canonical = ['POST', '/api/v1/integrations/atix/phone-lookups', timestamp, nonce, bodyHash].join('\\n');",
          "  pm.environment.set('atix_timestamp', timestamp);",
          "  pm.environment.set('atix_nonce', nonce);",
          "  pm.environment.set('atix_signature', CryptoJS.HmacSHA256(canonical, pm.environment.get('atix_hmac_secret')).toString(CryptoJS.enc.Hex));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('X-Correlation-ID presente', function () { pm.expect(pm.response.headers.get('X-Correlation-ID')).to.be.ok; });",
          "let body = {}; try { body = pm.response.json(); } catch (e) {}",
          "if (body.error) pm.test('error.correlation_id presente', function () { pm.expect(body.error.correlation_id).to.be.ok; });"
        ]
      }
    }
  ],
  "variable": [
    {"key":"base_url","value":""},
    {"key":"token","value":""},
    {"key":"atix_integration_key_id","value":""},
    {"key":"atix_hmac_secret","value":""},
    {"key":"correlation_id","value":""},
    {"key":"idempotency_key","value":""},
    {"key":"atix_timestamp","value":""},
    {"key":"atix_nonce","value":""},
    {"key":"atix_signature","value":""},
    {"key":"phone","value":"+525500000001"},
    {"key":"unknown_phone","value":"+525500000002"},
    {"key":"conversation_id","value":"synthetic-conv-v130-001"},
    {"key":"channel_event_id","value":"synthetic-event-v130-001"},
    {"key":"channel","value":"whatsapp"},
    {"key":"audience","value":"leo"},
    {"key":"brand","value":"olab"},
    {"key":"laboratory_test_id","value":""},
    {"key":"membership_plan_code","value":"basic_annual"},
    {"key":"coupon_code","value":"synthetic-coupon-v130"}
  ],
  "item": [
    {
      "name": "01 - Catalogo y membresias (solo lectura)",
      "item": [
        {"name":"catalogLaboratoryTests","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/catalog/laboratory-tests?brand={{brand}}"}},
        {"name":"catalogShowLaboratoryTest","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/catalog/laboratory-tests/{{laboratory_test_id}}"}},
        {"name":"membershipPlansIndex","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/memberships/plans"}},
        {"name":"membershipStatusShow","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/memberships/status"}}
      ]
    },
    {
      "name": "02 - Carrito medico y checkout/prepare",
      "item": [
        {"name":"cartIndex","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/cart?service_line=medical_services"}},
        {"name":"cartTotals","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/cart/totals?service_line=medical_services"}},
        {"name":"medicalServiceBenefitApply","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\n  \"service_line\": \"medical_services\",\n  \"code\": \"{{coupon_code}}\"\n}"},"url":"{{base_url}}/cart/medical-benefit"}},
        {"name":"medicalServiceBenefitRemove","request":{"method":"DELETE","header":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/cart/medical-benefit?service_line=medical_services"}},
        {"name":"checkoutPrepare","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/checkout/prepare?service_line=medical_services"}}
      ]
    },
    {
      "name": "03 - ATIX phone lookup",
      "item": [
        {
          "name":"atixPhoneLookup - HMAC valido",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"{{atix_timestamp}}"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"{{atix_signature}}"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\n  \"phone\": \"{{phone}}\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"channel_event_id\": \"{{channel_event_id}}\",\n  \"channel\": \"{{channel}}\",\n  \"audience\": \"{{audience}}\",\n  \"personalization\": {\"allowed\": true}\n}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        },
        {
          "name":"atixPhoneLookup - telefono desconocido anti-enumeracion",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"{{atix_timestamp}}"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"{{atix_signature}}"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\n  \"phone\": \"{{unknown_phone}}\",\n  \"conversation_id\": \"{{conversation_id}}-unknown\",\n  \"channel_event_id\": \"{{channel_event_id}}-unknown\",\n  \"channel\": \"{{channel}}\",\n  \"audience\": \"{{audience}}\",\n  \"personalization\": {\"allowed\": true}\n}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        },
        {
          "name":"atixPhoneLookup - firma invalida",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"{{atix_timestamp}}"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\"phone\":\"{{phone}}\",\"conversation_id\":\"{{conversation_id}}-bad-signature\",\"channel_event_id\":\"{{channel_event_id}}-bad-signature\",\"channel\":\"{{channel}}\",\"audience\":\"{{audience}}\",\"personalization\":{\"allowed\":false}}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        },
        {
          "name":"atixPhoneLookup - timestamp expirado",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"946684800"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"{{atix_signature}}"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\"phone\":\"{{phone}}\",\"conversation_id\":\"{{conversation_id}}-expired\",\"channel_event_id\":\"{{channel_event_id}}-expired\",\"channel\":\"{{channel}}\",\"audience\":\"{{audience}}\",\"personalization\":{\"allowed\":false}}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        },
        {
          "name":"atixPhoneLookup - channel invalido",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"{{atix_timestamp}}"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"{{atix_signature}}"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\"phone\":\"{{phone}}\",\"conversation_id\":\"{{conversation_id}}-channel\",\"channel_event_id\":\"{{channel_event_id}}-channel\",\"channel\":\"invalid-channel\",\"audience\":\"{{audience}}\",\"personalization\":{\"allowed\":false}}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        },
        {
          "name":"atixPhoneLookup - replay idempotente",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"{{atix_timestamp}}"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"{{atix_signature}}"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\"phone\":\"{{phone}}\",\"conversation_id\":\"{{conversation_id}}\",\"channel_event_id\":\"{{channel_event_id}}\",\"channel\":\"{{channel}}\",\"audience\":\"{{audience}}\",\"personalization\":{\"allowed\":true}}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        },
        {
          "name":"atixPhoneLookup - conflicto de payload",
          "request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"},{"key":"X-Integration-Key-Id","value":"{{atix_integration_key_id}}"},{"key":"X-Timestamp","value":"{{atix_timestamp}}"},{"key":"X-Nonce","value":"{{atix_nonce}}"},{"key":"X-Signature","value":"{{atix_signature}}"},{"key":"X-Correlation-ID","value":"{{correlation_id}}"},{"key":"Idempotency-Key","value":"{{idempotency_key}}"}],"body":{"mode":"raw","raw":"{\"phone\":\"{{unknown_phone}}\",\"conversation_id\":\"{{conversation_id}}\",\"channel_event_id\":\"{{channel_event_id}}\",\"channel\":\"{{channel}}\",\"audience\":\"{{audience}}\",\"personalization\":{\"allowed\":false}}"},"url":"{{base_url}}/integrations/atix/phone-lookups"}
        }
      ]
    },
    {
      "name":"04 - Reconocimiento pre-OTP",
      "item":[
        {"name":"authLoginRequestCode - contexto sintetico","request":{"method":"POST","header":[{"key":"Accept","value":"application/json"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"phone\": \"{{phone}}\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"channel_event_id\": \"{{channel_event_id}}-preotp\",\n  \"channel\": \"{{channel}}\",\n  \"personalization\": {\"allowed\": true}\n}"},"url":"{{base_url}}/auth/login/request-code"}},
        {"name":"membershipStatusShow - bloqueado sin Bearer","request":{"method":"GET","header":[{"key":"Accept","value":"application/json"}],"url":"{{base_url}}/memberships/status"}}
      ]
    }
  ]
}
