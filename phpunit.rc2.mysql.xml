<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="/var/www/html/vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Synthetic-only application key; never use a QA/production key here. -->
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <!-- Makes TestCase bind the real consumer pipeline to the local-only credential source. -->
        <env name="FAMEDIC_RC2_LOCAL_MYSQL" value="1" force="true"/>
        <!-- Prevents all ActiveCampaign network calls; target suites receive deterministic fake responses. -->
        <env name="FAMEDIC_RC2_ACTIVE_CAMPAIGN_FAKE" value="1" force="true"/>
        <env name="ACTIVE_CAMPAIGN_API_ENDPOINT" value="https://activecampaign.invalid" force="true"/>
        <env name="ACTIVE_CAMPAIGN_API_TOKEN" value="synthetic-test-token" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_NONE_EMAIL" value="membership-none@synthetic.invalid" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_NONE_PHONE" value="5550000011" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_REGULAR_EMAIL" value="membership-regular@synthetic.invalid" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_REGULAR_PHONE" value="5550000012" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_INSTITUTIONAL_EMAIL" value="membership-institutional@synthetic.invalid" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_INSTITUTIONAL_PHONE" value="5550000013" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_EXPIRED_EMAIL" value="membership-expired@synthetic.invalid" force="true"/>
        <env name="AKUBICA_UAT_MEMBERSHIP_EXPIRED_PHONE" value="5550000014" force="true"/>
        <!-- Prevents Scout from contacting Algolia in local UAT tests. -->
        <env name="SCOUT_DRIVER" value="null" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="rc2-local-mysql-20261110" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="famedic_rc2_uat_20261112_testing" force="true"/>
        <env name="DB_USERNAME" value="famedic_rc2_test" force="true"/>
        <env name="DB_PASSWORD" value="famedic_rc2_test_pw" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!--
          P0-T1: deterministic Akubica OTP baseline for PHPUnit/Pest.
          force=true so personal .env / Forge / shell exports cannot leak.
          Suites that exercise P0-A/P0-B must enable flags explicitly (config()->set).
          Do NOT introduce OTP_P0A_SMS_DELIVERY_PROVIDER (ignored by application code).
        -->
        <env name="OTP_P0A_INFRASTRUCTURE_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_AKUBICA_REGISTER_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_AKUBICA_LOGIN_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_SMS_DELIVERY_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_EMAIL_FALLBACK_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_ANTI_ABUSE_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_STEP_UP_RESULTS_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_STEP_UP_INVOICES_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_SECURE_LINKS_RESULTS_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_SECURE_LINKS_INVOICES_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_STEP_UP_BEARER_DOWNLOADS_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_STEP_UP_BEARER_RESULTS_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_STEP_UP_BEARER_INVOICES_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_SANCTUM_3H_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_CLEANUP_ENABLED" value="false" force="true"/>
        <env name="OTP_P0A_DELIVERY_DRIVER" value="fake" force="true"/>
        <env name="API_V1_IDEMPOTENCY_ENABLED" value="false" force="true"/>
        <env name="API_V1_IDEMPOTENCY_PRUNE_ENABLED" value="false" force="true"/>
        <env name="API_V1_AUDIT_ENABLED" value="false" force="true"/>
        <env name="BUSINESS_AUDIT_ENABLED" value="false" force="true"/>
        <env name="COUPON_CREATION_OTP_REQUIRED" value="true"/>
    </php>
</phpunit>
