APP_NAME=Famedic
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

BCRYPT_ROUNDS=4

# SQLite aislado: archivo bajo database/ (ver config/database.php → database_path()).
# No usar :memory: sin ajustar config/database.php (se interpreta como ruta de archivo).
DB_CONNECTION=sqlite
DB_DATABASE=test_db.sqlite

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false

SCOUT_DRIVER=null

# Stubs locales para bootstrapping; no credenciales productivas.
ACTIVE_CAMPAIGN_API_ENDPOINT=https://activecampaign.test/api/3
ACTIVE_CAMPAIGN_API_TOKEN=testing-token-not-used
ACTIVE_CAMPAIGN_ACCOUNT_ID=1
ACTIVE_CAMPAIGN_EVENT_KEY=testing-event-key-not-used
ACTIVE_CAMPAIGN_ENABLED=true
ACTIVECAMPAIGN_CART_OUTBOX_ENABLED=true
ACTIVECAMPAIGN_TAG_ABANDONED_CARTS_ENABLED=true
ACTIVECAMPAIGN_CART_SITE_EVENTS_ENABLED=false
ACTIVECAMPAIGN_CART_TAG_REMOVE_ENABLED=false
ACTIVE_CAMPAIGN_ACCOUNT_ID=1
ACTIVE_CAMPAIGN_EVENT_KEY=testing-event-key-not-used

COUPON_CREATION_OTP_REQUIRED=true
