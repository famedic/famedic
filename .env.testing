APP_NAME=Famedic
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

BCRYPT_ROUNDS=4

# MySQL de pruebas. Para regresiones locales, preferir una BD descartable por corrida:
# TEST_DB_DATABASE=famedic_test_description_ia_<timestamp>.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=famedic_test_description_ia
DB_USERNAME=famedic
DB_PASSWORD=famedic
TEST_DB_CONNECTION=mysql
TEST_DB_DATABASE=famedic_test_description_ia

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false

SCOUT_DRIVER=null

# Stubs locales para bootstrapping; no credenciales productivas.
ACTIVE_CAMPAIGN_API_ENDPOINT=https://activecampaign.test/api/3
ACTIVE_CAMPAIGN_API_TOKEN=testing-token-not-used
ACTIVE_CAMPAIGN_ACCOUNT_ID=1
ACTIVE_CAMPAIGN_EVENT_KEY=testing-event-key-not-used
ACTIVE_CAMPAIGN_ENABLED=false
ACTIVECAMPAIGN_CART_OUTBOX_ENABLED=false
ACTIVECAMPAIGN_TAG_ABANDONED_CARTS_ENABLED=false
ACTIVECAMPAIGN_CART_SITE_EVENTS_ENABLED=false
ACTIVECAMPAIGN_CART_TAG_REMOVE_ENABLED=false
ACTIVE_CAMPAIGN_ACCOUNT_ID=1
ACTIVE_CAMPAIGN_EVENT_KEY=testing-event-key-not-used

COUPON_CREATION_OTP_REQUIRED=true

# Indicaciones IA v3: desactivado en tests salvo override explícito en el caso de prueba.
LAB_PREPARATION_DETERMINISTIC_V3_ENABLED=false
LAB_PREPARATION_DETERMINISTIC_V3_SHADOW_ENABLED=false
